{
  "name": "@dr-co/dsh-storage",
  "version": "0.2.17",
  "description": "Remote disks for DeepSeek Harness: cloud storages a model can read and write, plus encrypted backups on top of them",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./s3": "./s3.mjs",
    "./backup": "./backup.mjs",
    "./selfbackup": "./selfbackup.mjs",
    "./testhook": "./testhook.mjs",
    "./scripts": "./scripts.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "s3.mjs",
    "webdav.mjs",
    "yadisk.mjs",
    "backup.mjs",
    "selfbackup.mjs",
    "testhook.mjs",
    "scripts.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.4",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.4",
    "@deepseek-ai/schemastery": "~3.18.5",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "openpgp": "^6.3.2"
  }
}
